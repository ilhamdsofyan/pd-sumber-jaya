# =========================
# OS & Editor
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# =========================
# WordPress Core Files
# =========================
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php

# =========================
# WP Config & Secrets
# =========================
# (Already covered by /wp-*.php above, but good to be explicit)
/wp-config.php
/wp-config-local.php
.env
.env.*

# =========================
# Uploads, Cache, & Upgrades
# =========================
/wp-content/uploads/
/wp-content/cache/
/wp-content/litespeed/
/wp-content/updraft/
/wp-content/upgrade/
/wp-content/languages/
/wp-content/index.php

# =========================
# Plugins
# =========================
# Ignore all plugins to prevent bloating your repo
/wp-content/plugins/*

# Note: If you have a custom plugin you want to track, un-ignore it like this:
# !/wp-content/plugins/your-custom-plugin/

# =========================
# Themes
# =========================
# Ignore all themes except the ones you use
/wp-content/themes/*
!/wp-content/themes/generatepress/
!/wp-content/themes/generatepress-child/
!/wp-content/themes/pd-sumber-jaya/

# =========================
# Node / Build Tools
# =========================
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Misc
# =========================
*.zip
*.tar.gz
*.sql
